#!/usr/bin/env bash
set -euo pipefail
BASE=/etc/carrot-net
ACTIVE=/etc/netplan/99-carrot.yaml
usage() {
  printf '%s\n' \
    'Usage:' \
    '  sudo carrot-net add-fallback <SSID>' \
    '  sudo carrot-net create-auto' \
    '  sudo carrot-net select home|field|auto|rescue' \
    '  sudo carrot-net status'
}
[[ $EUID -eq 0 ]] || { echo 'run with sudo' >&2; exit 2; }
print_redacted_netplan() {
  netplan get all 2>/dev/null \
    | sed -E 's/^([[:space:]]*password:).*/\1 "***"/' \
    || true
}
ensure_exclusive_netplan() {
  local path
  for path in /etc/netplan/*.yaml; do
    [[ -e "$path" && "$path" != "$ACTIVE" ]] || continue
    printf 'refusing to select a profile while another Netplan file exists: %s\n' "$path" >&2
    exit 1
  done
}
case "${1:-}" in
  add-fallback)
    ssid=${2:-}
    [[ -n "$ssid" && $# -eq 2 ]] || { usage; exit 2; }
    [[ "$ssid" != *$'\n'* && "$ssid" != *$'\r'* && "$ssid" != REPLACE_* ]] || {
      echo 'invalid fallback SSID' >&2
      exit 2
    }
    [[ ! -e "$BASE/fallback.yaml" ]] || {
      echo 'fallback profile already exists; remove it locally before replacing it' >&2
      exit 1
    }
    CARROT_NET_FALLBACK_SSID="$ssid" python3 - <<'PY'
import copy
import getpass
import os
import sys
import tempfile

import yaml

base = os.environ.get('CARROT_NET_BASE', '/etc/carrot-net')
ssid = os.environ['CARROT_NET_FALLBACK_SSID']
path = os.path.join(base, 'fallback.yaml')

try:
    password = getpass.getpass(f'Password for Wi-Fi "{ssid}": ')
    if not password:
        raise ValueError('password must not be empty')
    with open(os.path.join(base, 'field.yaml'), encoding='utf-8') as stream:
        profile = yaml.safe_load(stream)
    profile['network']['wifis']['wlan0']['access-points'] = {
        ssid: {'password': password},
    }
    rendered = '# carrot-profile: fallback\n'
    rendered += yaml.safe_dump(profile, allow_unicode=True, default_flow_style=False, sort_keys=False)
    fd, temporary = tempfile.mkstemp(prefix='.fallback.yaml.', dir=base)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
except (OSError, KeyError, TypeError, ValueError, yaml.YAMLError) as error:
    print(f'cannot add fallback profile: {error}', file=sys.stderr)
    sys.exit(1)
PY
    printf 'Added protected fallback profile. Run create-auto, select auto, then reboot to apply it.\n' ;;
  create-auto)
    python3 - <<'PY'
import copy
import os
import sys
import tempfile

import yaml

base = os.environ.get('CARROT_NET_BASE', '/etc/carrot-net')

def load_profile(name):
    with open(os.path.join(base, name), encoding='utf-8') as stream:
        return yaml.safe_load(stream)

try:
    home = load_profile('home.yaml')
    field = load_profile('field.yaml')
    home_aps = home['network']['wifis']['wlan0']['access-points']
    field_aps = field['network']['wifis']['wlan0']['access-points']
    if len(home_aps) != 1 or len(field_aps) != 1:
        raise ValueError('each source profile must contain exactly one Wi-Fi access point')
    home_ssid = next(iter(home_aps))
    hotspot_ssid = next(iter(field_aps))
    profiles = [(home_ssid, home_aps[home_ssid]), (hotspot_ssid, field_aps[hotspot_ssid])]
    fallback_path = os.path.join(base, 'fallback.yaml')
    fallback_ssid = None
    if os.path.exists(fallback_path):
        fallback = load_profile('fallback.yaml')
        fallback_aps = fallback['network']['wifis']['wlan0']['access-points']
        if len(fallback_aps) != 1:
            raise ValueError('fallback profile must contain exactly one Wi-Fi access point')
        fallback_ssid = next(iter(fallback_aps))
        profiles.append((fallback_ssid, fallback_aps[fallback_ssid]))
    ssids = [ssid for ssid, _ in profiles]
    if len(set(ssids)) != len(ssids):
        raise ValueError('home Wi-Fi, hotspot, and fallback SSIDs must differ')
    if any('REPLACE_' in ssid for ssid in ssids):
        raise ValueError('source profile still contains a placeholder')
    auto = copy.deepcopy(field)
    network = auto['network']
    network['wifis']['wlan0']['access-points'] = {
        ssid: copy.deepcopy(access_point) for ssid, access_point in profiles
    }
    rendered = '# carrot-profile: auto\n'
    rendered += '# carrot-hotspot-ssid: ' + hotspot_ssid + '\n'
    rendered += '# carrot-home-ssid: ' + home_ssid + '\n'
    if fallback_ssid is not None:
        rendered += '# carrot-fallback-ssid: ' + fallback_ssid + '\n'
    rendered += yaml.safe_dump(auto, allow_unicode=True, default_flow_style=False, sort_keys=False)
    fd, temporary = tempfile.mkstemp(prefix='.auto.yaml.', dir=base)
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream:
            stream.write(rendered)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, os.path.join(base, 'auto.yaml'))
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
except (OSError, KeyError, TypeError, ValueError, yaml.YAMLError) as error:
    print(f'cannot create auto profile: {error}', file=sys.stderr)
    sys.exit(1)
PY
    printf 'Created auto profile from local home and field profiles; hotspot is preferred at boot.\n' ;;
  select)
    mode=${2:-}; [[ $mode == home || $mode == field || $mode == auto || $mode == rescue ]] || { usage; exit 2; }
    install -d -m 0755 /etc/netplan
    ensure_exclusive_netplan
    install -m 0600 "$BASE/$mode.yaml" "$ACTIVE"
    printf 'Selected %s for next boot; current network is unchanged.\n' "$mode" ;;
  status)
    printf 'active profile: '; sed -n 's/^# carrot-profile: //p' "$ACTIVE" 2>/dev/null || echo none
    print_redacted_netplan
    ip -br addr 2>/dev/null || true
    ip route 2>/dev/null || true ;;
  *) usage; exit 2 ;;
esac
