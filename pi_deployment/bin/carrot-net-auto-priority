#!/usr/bin/env bash
set -euo pipefail

ACTIVE=${CARROT_NET_ACTIVE:-/etc/netplan/99-carrot.yaml}
CONNECTIONS=${CARROT_NM_CONNECTIONS:-/run/NetworkManager/system-connections}

[[ -r "$ACTIVE" ]] || exit 0
grep -qx '# carrot-profile: auto' "$ACTIVE" || exit 0
hotspot=$(sed -n 's/^# carrot-hotspot-ssid: //p' "$ACTIVE")
home=$(sed -n 's/^# carrot-home-ssid: //p' "$ACTIVE")
fallback=$(sed -n 's/^# carrot-fallback-ssid: //p' "$ACTIVE")
[[ -n "$hotspot" && -n "$home" ]] || {
  echo 'auto network profile has incomplete priority markers' >&2
  exit 1
}

declare -A priority=(
  ["$hotspot"]=100
  ["$home"]=10
)
expected=2
if [[ -n "$fallback" ]]; then
  priority["$fallback"]=5
  expected=3
fi

found=0
for profile in "$CONNECTIONS"/netplan-wlan0-*.nmconnection; do
  [[ -f "$profile" ]] || continue
  ssid=$(sed -n 's/^ssid=//p' "$profile" | head -1)
  [[ -n "$ssid" ]] || continue
  [[ -v "priority[$ssid]" ]] || {
    echo 'auto network profile produced an unexpected Wi-Fi connection' >&2
    exit 1
  }
  connection_priority=${priority[$ssid]}
  temporary=$(mktemp "${profile}.XXXXXX")
  awk -v priority="$connection_priority" '
    BEGIN { in_connection = 0; wrote = 0; wrote_retries = 0 }
    $0 == "[connection]" { in_connection = 1 }
    in_connection && /^autoconnect-priority=/ {
      print "autoconnect-priority=" priority
      wrote = 1
      next
    }
    in_connection && /^autoconnect-retries=/ {
      print "autoconnect-retries=1"
      wrote_retries = 1
      next
    }
    in_connection && /^\[/ && $0 != "[connection]" {
      if (!wrote) print "autoconnect-priority=" priority
      if (!wrote_retries) print "autoconnect-retries=1"
      in_connection = 0
      wrote = 1
      wrote_retries = 1
    }
    { print }
    END {
      if (in_connection && !wrote) print "autoconnect-priority=" priority
      if (in_connection && !wrote_retries) print "autoconnect-retries=1"
    }
  ' "$profile" > "$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$profile"
  found=$((found + 1))
done

(( found == expected )) || {
  echo "auto network profile: expected $expected generated Wi-Fi connections, found $found" >&2
  exit 1
}

# NetworkManager keeps connection settings in memory; reload after editing the
# generated keyfiles so the retry policy applies without a reboot.
nmcli connection reload
