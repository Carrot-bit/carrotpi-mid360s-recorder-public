#!/usr/bin/env bash
set -Eeuo pipefail
set +u

ROS_SETUP=/opt/ros/humble/setup.bash
WS_SETUP=/home/carrotuser/carrot_ws/install/setup.bash
WATCHDOG=/usr/local/lib/carrot-recorder/topic_watchdog.py
MOUNT_POINT=/mnt/carrot_disk
BAG_ROOT=$MOUNT_POINT/carrot_rosbags
EVIDENCE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/carrot-recorder/runs
CONTROL_ROOT=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/carrot-recorder
LOCK_FILE=$CONTROL_ROOT/recorder.lock
MONITOR_LOCK_FILE=$CONTROL_ROOT/monitor.lock
STATE_FILE=$CONTROL_ROOT/state
DRIVER_UNIT=carrot-driver.service
LIDAR_TOPIC=/livox/lidar
IMU_TOPIC=/livox/imu
LIDAR_TYPE=livox_ros_driver2/msg/CustomMsg
IMU_TYPE=sensor_msgs/msg/Imu
INITIAL_STATIC_SECONDS=15

ensure_dirs() { mkdir -p "$CONTROL_ROOT" "$EVIDENCE_ROOT"; }
fail() { printf 'carrot-bag: %s\n' "$*" >&2; exit 1; }
valid_label() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
monotonic_seconds() { awk '{print int($1)}' /proc/uptime; }
state_get() { [[ -r "$STATE_FILE" ]] && sed -n "s/^$1=//p" "$STATE_FILE" | head -1; }
write_state() {
  local tmp="$STATE_FILE.$$"
  {
    printf 'pid=%s\nphase=%s\nlabel=%s\noutput=%s\nlogs=%s\n' \
      "$BASHPID" "$1" "$LABEL" "${OUTPUT:-}" "${RUN_LOG:-}"
    printf 'started_mono=%s\nstopped_mono=%s\ndeadline=%s\nprompt_deadline=%s\n' \
      "${START_MONO:-0}" "${STOP_MONO:-0}" "${DEADLINE:-0}" "${PROMPT_DEADLINE:-0}"
  } > "$tmp"
  mv -f "$tmp" "$STATE_FILE"
}
storage_guard() { /usr/local/bin/carrot-storage-guard >/dev/null; }
runtime_storage_guard() { CARROT_MIN_FREE_KB=20971520 /usr/local/bin/carrot-storage-guard >/dev/null; }
source_ros() { source "$ROS_SETUP"; source "$WS_SETUP"; export ROS_LOCALHOST_ONLY=1; }
active_pid() { systemctl --user show -p MainPID --value "$1" 2>/dev/null || true; }
check_health() {
  local temp=unknown throttle=unknown
  [[ -r /sys/class/thermal/thermal_zone0/temp ]] && temp=$(cat /sys/class/thermal/thermal_zone0/temp)
  command -v vcgencmd >/dev/null 2>&1 && throttle=$(vcgencmd get_throttled 2>/dev/null | sed 's/.*=//')
  printf '%s\t%s\t%s\t%s\n' "$(date -Is)" "$temp" "$throttle" "$(cat /proc/loadavg)" >> "$RUN_LOG/health.tsv"
  [[ "$temp" == unknown || "$temp" =~ ^[0-9]+$ ]] || return 1
  [[ "$temp" == unknown || "$temp" -lt 80000 ]] || return 1
  [[ "$throttle" == unknown || "$throttle" == 0x0 ]] || return 1
}
capture_evidence() {
  { ip -s link show dev eth0; free -h; dmesg -T | tail -200; tail -200 /var/log/kern.log; } > "$RUN_LOG/system_snapshot.txt" 2>&1 || true
}
preserve_failed_run() {
  local rc=$?
  trap - EXIT
  if (( rc != 0 )) && [[ -n "${OUTPUT:-}" && -n "${RUN_LOG:-}" ]]; then
    capture_evidence
    mkdir -p "$OUTPUT" 2>/dev/null || true
    [[ -e "$OUTPUT/COMPLETE" ]] || touch "$OUTPUT/FAILED" 2>/dev/null || true
    cp -f "$RUN_LOG"/* "$OUTPUT/" 2>/dev/null || true
  fi
  (( rc == 0 )) || rm -f "$STATE_FILE"
  exit "$rc"
}
abort_if_stop_requested() {
  if [[ -e "$CONTROL_ROOT/stop" ]]; then
    rm -f "$CONTROL_ROOT/stop"
    fail 'safe stop requested before recording started'
  fi
}
check_kernel_errors() {
  [[ -r "${KERNEL_LOG:-}" ]] || return 0
  local first_line=$((KERNEL_LOG_LINES + 1))
  tail -n "+$first_line" "$KERNEL_LOG" 2>/dev/null | \
    grep -Eiq '(usb .*reset|uas.*error|ntfs.*(error|fail)|i/o error|buffer i/o)' && return 1
  KERNEL_LOG_LINES=$(wc -l < "$KERNEL_LOG")
}
verify_completed_bag() {
  ros2 bag info "$OUTPUT" > "$RUN_LOG/bag_info.txt" 2>&1
  cp -f "$OUTPUT/metadata.yaml" "$RUN_LOG/bag_info.yaml"
  python3 /usr/local/lib/carrot-recorder/verify_bag.py "$RUN_LOG/bag_info.yaml" > "$RUN_LOG/bag_verification.txt"
}

format_duration() {
  local total=${1:-0}
  (( total >= 0 )) || total=0
  printf '%dh%02dmin%02ds' "$((total / 3600))" "$(((total % 3600) / 60))" "$((total % 60))"
}

format_bytes() {
  local bytes=${1:-}
  [[ "$bytes" =~ ^[0-9]+$ ]] || { printf '%s' '--'; return; }
  awk -v value="$bytes" 'BEGIN {
    split("B K M G T", units, " ")
    unit = 1
    while (value >= 1024 && unit < 5) { value /= 1024; unit++ }
    if (unit == 1 || value >= 100) printf "%.0f%s", value, units[unit]
    else printf "%.1f%s", value, units[unit]
  }'
}

phase_text() {
  case "$1" in
    preparing) printf '正在准备录制' ;;
    storage_check) printf '正在检查录包硬盘' ;;
    driver_verify) printf '正在校验雷达驱动' ;;
    driver_start) printf '正在启动雷达驱动' ;;
    driver_reuse) printf '正在复用已运行的雷达驱动' ;;
    topic_check) printf '正在等待 LiDAR/IMU 话题' ;;
    rate_check) printf '正在测量话题频率' ;;
    recorder_start) printf '正在启动 rosbag 录制器' ;;
    prompt) printf '等待是否延长录制' ;;
    stopping) printf '正在安全停止并刷新 bag' ;;
    verifying) printf '正在校验 bag 完整性' ;;
    *) printf '正在处理录制任务' ;;
  esac
}

latest_output_for_label() {
  local label=$1
  find "$BAG_ROOT" -mindepth 1 -maxdepth 1 -type d -name "${label}_*" \
    -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-
}

print_run_summary() {
  local output=$1 mode=${2:-finished} result verification reason recorded_seconds
  local bag_bytes bag_size checksum topics evidence_dir
  [[ -d "$output" ]] || return 1
  if [[ -e "$output/COMPLETE" && ! -e "$output/FAILED" ]]; then
    result=COMPLETE; verification=通过
  else
    result=FAILED; verification=失败
  fi
  reason=$(sed -n 's/^stop_reason=//p' "$output/session.txt" 2>/dev/null | tail -1)
  [[ -n "$reason" ]] || reason=unknown
  recorded_seconds=$(sed -n 's/^recorded_seconds=//p' "$output/session.txt" 2>/dev/null | tail -1)
  [[ "$recorded_seconds" =~ ^[0-9]+$ ]] || recorded_seconds=0
  bag_bytes=$(find "$output" -maxdepth 1 -type f -name '*.db3' -printf '%s\n' 2>/dev/null \
    | awk '{sum += $1} END {printf "%.0f", sum}')
  bag_size=$(format_bytes "$bag_bytes")
  checksum=未执行
  if [[ -f "$output/bag_files.sha256" ]]; then
    if (cd "$output" && sha256sum -c bag_files.sha256 >/dev/null 2>&1); then
      checksum=通过
    else
      checksum=失败
      verification=失败
      result=FAILED
    fi
  fi
  topics=$(grep -E '^/livox/(lidar|imu):' "$output/bag_verification.txt" 2>/dev/null \
    | awk 'BEGIN { separator = "" } { printf "%s%s", separator, $0; separator = " | " }')
  [[ -n "$topics" ]] || topics=未生成
  evidence_dir=${output/$BAG_ROOT/$EVIDENCE_ROOT}
  printf '%s\n' "录制摘要（${mode}）" \
    "结果：$result" \
    "停止原因：$reason" \
    "路径：$output" \
    "累计时长：$(format_duration "$recorded_seconds")" \
    "bag 大小：$bag_size" \
    "话题：$topics" \
    "完整性校验：$verification；SHA-256：$checksum" \
    "运行日志：$evidence_dir"
  [[ "$result" == COMPLETE ]]
}

print_service_failure_summary() {
  local unit=$1 label=$2 result exit_status
  result=$(systemctl --user show -p Result --value "$unit" 2>/dev/null || true)
  exit_status=$(systemctl --user show -p ExecMainStatus --value "$unit" 2>/dev/null || true)
  [[ -n "$result" ]] || result=unknown
  [[ -n "$exit_status" ]] || exit_status=unknown
  printf '%s\n' '录制摘要（启动或前台异常结束）' \
    '结果：FAILED' \
    "任务：$label" \
    "systemd：Result=$result，ExecMainStatus=$exit_status" \
    '输出目录：未创建或状态不可用' \
    "日志：carrot-bag logs $label"
  journalctl --user -u "$unit" -n 8 --no-pager 2>/dev/null || true
  return 1
}

monitor_recording() {
  local monitor_label=$1
  local unit="carrot-bag@${monitor_label}.service"
  local display_lines=0 monitor_stop_requested=0 monitor_detach=0
  local last_output= last_started=0 last_stopped=0 phase= initial_wait=0
  local color_reset= color_green= color_yellow= color_red= color_cyan=
  local use_color=0 columns

  exec 8>"$MONITOR_LOCK_FILE"
  flock -n 8 || fail 'another foreground monitor is already attached; close it before reconnecting'

  if [[ "${TERM:-dumb}" != dumb && -z "${NO_COLOR:-}" ]]; then
    use_color=1
    color_reset=$'\033[0m'; color_green=$'\033[32m'; color_yellow=$'\033[33m'
    color_red=$'\033[31m'; color_cyan=$'\033[36m'
  fi

  clear_monitor_display() {
    if (( display_lines == 2 )); then
      printf '\r\033[2K\033[1A\r\033[2K'
    elif (( display_lines == 1 )); then
      printf '\r\033[2K'
    fi
    display_lines=0
  }

  render_monitor_display() {
    local first=$1 second=$2
    if (( display_lines == 2 )); then printf '\033[1A'; fi
    printf '\r\033[2K%b\n\r\033[2K%b' "$first" "$second"
    display_lines=2
  }

  trap 'monitor_stop_requested=1; touch "$CONTROL_ROOT/stop"' INT
  trap 'monitor_detach=1' HUP TERM

  while :; do
    if (( monitor_detach == 1 )); then
      clear_monitor_display
      output_now=$(state_get output 2>/dev/null || true)
      printf '前台界面已退出，后台录制仍在继续。\n'
      printf '状态：%s\n' "$(phase_text "$(state_get phase 2>/dev/null || true)")"
      [[ -n "$output_now" ]] && printf '路径：%s\n' "$output_now"
      printf '重新连接后执行：carrot-bag watch %s\n' "$monitor_label"
      trap - INT HUP TERM
      return 0
    fi

    phase=$(state_get phase 2>/dev/null || true)
    state_label=$(state_get label 2>/dev/null || true)
    if [[ -n "$state_label" && "$state_label" != "$monitor_label" ]]; then
      clear_monitor_display
      trap - INT HUP TERM
      fail "another recording is active: $state_label"
    fi
    current_output=$(state_get output 2>/dev/null || true)
    current_started=$(state_get started_mono 2>/dev/null || true)
    current_stopped=$(state_get stopped_mono 2>/dev/null || true)
    [[ -n "$current_output" ]] && last_output=$current_output
    [[ "$current_started" =~ ^[0-9]+$ && "$current_started" -gt 0 ]] && last_started=$current_started
    [[ "$current_stopped" =~ ^[0-9]+$ && "$current_stopped" -gt 0 ]] && last_stopped=$current_stopped

    if ! systemctl --user is-active --quiet "$unit"; then
      if [[ -z "$phase" && $initial_wait -lt 20 ]]; then
        initial_wait=$((initial_wait + 1))
        render_monitor_display "${color_cyan}正在等待录制服务启动${color_reset}" ''
        sleep 0.1 || true
        continue
      fi
      break
    fi
    initial_wait=20

    if [[ "$phase" == prompt ]]; then
      clear_monitor_display
      now=$(monotonic_seconds)
      prompt_deadline=$(state_get prompt_deadline 2>/dev/null || true)
      [[ "$prompt_deadline" =~ ^[0-9]+$ ]] || prompt_deadline=$((now + 1))
      prompt_seconds=$((prompt_deadline - now))
      (( prompt_seconds > 0 )) || prompt_seconds=1
      printf '已录制60分钟，是否继续录制60分钟？[y/N] '
      answer=n
      if read -r -t "$prompt_seconds" answer; then
        printf '\033[1A\r\033[2K'
      else
        printf '\r\033[2K'
      fi
      if (( monitor_detach == 1 )); then
        trap - INT HUP TERM
        return 129
      fi
      case "${answer,,}" in
        y|yes)
          touch "$CONTROL_ROOT/extend" ;;
        *)
          touch "$CONTROL_ROOT/stop"
          monitor_stop_requested=1 ;;
      esac
      # The service owns the prompt transition. Waiting here prevents this
      # frontend (or a slow terminal) from rendering the same prompt twice.
      for _ in $(seq 1 50); do
        [[ "$(state_get phase 2>/dev/null || true)" != prompt ]] && break
        systemctl --user is-active --quiet "$unit" || break
        sleep 0.2 || true
      done
      continue
    fi

    if (( monitor_stop_requested == 1 )) && [[ "$phase" == recording ]]; then
      render_monitor_display "${color_cyan}正在请求安全停止${color_reset}" '正在等待后台录制服务响应'
      sleep 0.5 || true
      continue
    fi

    if [[ "$phase" != recording ]]; then
      render_monitor_display "${color_cyan}$(phase_text "$phase")${color_reset}" '请稍候，^C 可安全停止'
      sleep 0.5 || true
      continue
    fi

    now=$(monotonic_seconds)
    elapsed=0
    (( last_started > 0 && now >= last_started )) && elapsed=$((now - last_started))
    elapsed_text=$(format_duration "$elapsed")
    if (( elapsed < INITIAL_STATIC_SECONDS )); then
      motion="${color_yellow}保持静止 $((INITIAL_STATIC_SECONDS - elapsed))s${color_reset}"
      motion_short="${color_yellow}静止$((INITIAL_STATIC_SECONDS - elapsed))s${color_reset}"
    else
      motion="${color_green}可移动${color_reset}"
      motion_short=$motion
    fi

    temp_raw=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true)
    if [[ "$temp_raw" =~ ^[0-9]+$ ]]; then
      temp_value=$(awk -v value="$temp_raw" 'BEGIN {printf "%.1f", value / 1000}')
      temp_integer=$((temp_raw / 1000))
      if (( temp_raw >= 75000 )); then temp_color=$color_red
      elif (( temp_raw >= 65000 )); then temp_color=$color_yellow
      else temp_color=$color_green
      fi
      temp_full="${temp_color}${temp_value}C${color_reset}"
      temp_short="${temp_color}${temp_integer}C${color_reset}"
    else
      temp_full=--; temp_short=--
    fi

    load_one=$(awk '{print $1}' /proc/loadavg 2>/dev/null || true)
    cpu_count=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
    [[ "$cpu_count" =~ ^[1-9][0-9]*$ ]] || cpu_count=1
    load_level=$(awk -v load_value="$load_one" -v cpus="$cpu_count" 'BEGIN {
      if (load_value !~ /^[0-9]+([.][0-9]+)?$/) print "unknown"
      else if (load_value / cpus >= 0.85) print "high"
      else if (load_value / cpus >= 0.50) print "medium"
      else print "low"
    }')
    case "$load_level" in
      high) load_color=$color_red; load_word=高 ;;
      medium) load_color=$color_yellow; load_word=中 ;;
      low) load_color=$color_green; load_word=低 ;;
      *) load_color=; load_word=-- ;;
    esac
    if (( use_color == 1 )); then load_mark="${load_color}●${color_reset}"
    else load_mark="[${load_word}]"
    fi

    bag_bytes=
    if [[ -d "$last_output" ]]; then
      bag_bytes=$(find "$last_output" -maxdepth 1 -type f -name '*.db3' -printf '%s\n' 2>/dev/null \
        | awk '{sum += $1} END {printf "%.0f", sum}')
    fi
    bag_size=$(format_bytes "$bag_bytes")
    free_kb=$(df -Pk "$MOUNT_POINT" 2>/dev/null | awk 'NR == 2 {print $4}')
    if [[ "$free_kb" =~ ^[0-9]+$ ]]; then disk_free=$(format_bytes "$((free_kb * 1024))")
    else disk_free=--
    fi

    columns=$(tput cols 2>/dev/null || printf '80')
    [[ "$columns" =~ ^[0-9]+$ ]] || columns=80
    if (( columns >= 64 )); then
      first="${color_green}正在录制${color_reset} ${elapsed_text} | ${motion} | ${color_yellow}^C停止${color_reset}"
      second="${load_mark} 负载 | 温度 ${temp_full} | bag ${bag_size} | 磁盘余 ${disk_free}"
    else
      first="${color_green}录制${color_reset} ${elapsed_text} | ${motion_short} | ${color_yellow}^C停止${color_reset}"
      second="${load_mark}负载 ${temp_short} bag${bag_size} 余${disk_free}"
    fi
    render_monitor_display "$first" "$second"
    sleep 1 || true
  done

  clear_monitor_display
  trap - INT HUP TERM
  if [[ -n "$last_output" ]]; then
    print_run_summary "$last_output" '已完成'
  else
    print_service_failure_summary "$unit" "$monitor_label"
  fi
}

usage() { printf '%s\n' \
  'carrot-bag start LABEL [minutes]' 'carrot-bag run LABEL (systemd internal)' \
  'carrot-bag watch LABEL' 'carrot-bag extend LABEL' 'carrot-bag stop' \
  'carrot-bag status' 'carrot-bag logs LABEL' 'carrot-bag driver-stop'; }

cmd=${1:-help}; LABEL=${2:-}; MINUTES=${3:-60}
case "$cmd" in
  start)
    valid_label "$LABEL" || fail 'label must match [A-Za-z0-9][A-Za-z0-9._-]*'
    [[ "$MINUTES" =~ ^[1-9][0-9]*$ && "$MINUTES" -le 60 ]] || fail 'minutes must be 1..60'
    ensure_dirs
    if [[ -r "$STATE_FILE" ]]; then
      active_label=$(state_get label)
      if [[ -n "$active_label" ]] && systemctl --user is-active --quiet "carrot-bag@${active_label}.service"; then
        fail "a recording is already active: $(state_get output)"
      fi
      rm -f "$STATE_FILE"
    fi
    rm -f "$CONTROL_ROOT/stop" "$CONTROL_ROOT/extend"
    printf '%s\n' "$MINUTES" > "$CONTROL_ROOT/duration.${LABEL}"
    if ! systemctl --user start "carrot-bag@${LABEL}.service"; then
      rm -f "$CONTROL_ROOT/duration.${LABEL}"
      print_service_failure_summary "carrot-bag@${LABEL}.service" "$LABEL"
      exit 1
    fi
    if [[ -t 0 && -t 1 ]]; then
      monitor_recording "$LABEL"
    else
      printf 'started %s in background; use carrot-bag watch %s\n' "$LABEL" "$LABEL"
    fi ;;
  run)
    ensure_dirs
    valid_label "$LABEL" || exit 2
    duration_file="$CONTROL_ROOT/duration.${LABEL}"
    if [[ -r "$duration_file" ]]; then
      MINUTES=$(<"$duration_file")
      rm -f "$duration_file"
    else
      MINUTES=60
    fi
    [[ "$MINUTES" =~ ^[1-9][0-9]*$ && "$MINUTES" -le 60 ]] || fail 'invalid requested duration'
    exec 9>"$LOCK_FILE"
    flock -n 9 || fail 'another recorder is active'
    rm -f "$CONTROL_ROOT/stop" "$CONTROL_ROOT/extend"
    OUTPUT=; RUN_LOG=; START_MONO=0; STOP_MONO=0; DEADLINE=0; PROMPT_DEADLINE=0
    write_state preparing
    trap 'rc=$?; (( rc == 0 )) || rm -f "$STATE_FILE"; exit "$rc"' EXIT
    source_ros
    write_state storage_check
    storage_guard
    abort_if_stop_requested
    write_state driver_verify
    /usr/local/bin/carrot-livox-verify
    abort_if_stop_requested
    mkdir -p "$BAG_ROOT" "$EVIDENCE_ROOT"
    TIMESTAMP=$(date +%Y%m%d_%H%M%S)
    OUTPUT="$BAG_ROOT/${LABEL}_${TIMESTAMP}"
    RUN_LOG="$EVIDENCE_ROOT/${LABEL}_${TIMESTAMP}"
    mkdir -p "$RUN_LOG"
    [[ ! -e "$OUTPUT" ]] || fail "refusing to overwrite $OUTPUT"
    trap preserve_failed_run EXIT
    printf 'label=%s\nstarted=%s\n' "$LABEL" "$(date -Is)" > "$RUN_LOG/session.txt"
    if ! systemctl --user is-active --quiet "$DRIVER_UNIT"; then
      write_state driver_start
      existing_lidar=$(timeout 3 ros2 topic type "$LIDAR_TOPIC" 2>/dev/null || true)
      existing_imu=$(timeout 3 ros2 topic type "$IMU_TOPIC" 2>/dev/null || true)
      [[ -z "$existing_lidar" && -z "$existing_imu" ]] || fail 'unmanaged Livox topics already exist; stop them before recording'
      systemctl --user start "$DRIVER_UNIT"
      DRIVER_STARTED=1
    else
      write_state driver_reuse
      DRIVER_STARTED=0
    fi
    write_state topic_check
    ready=0
    for _ in $(seq 1 35); do
      abort_if_stop_requested
      lt=$(timeout 3 ros2 topic type "$LIDAR_TOPIC" 2>/dev/null || true)
      it=$(timeout 3 ros2 topic type "$IMU_TOPIC" 2>/dev/null || true)
      if [[ "$lt" == "$LIDAR_TYPE" && "$it" == "$IMU_TYPE" ]]; then ready=1; break; fi
      sleep 1
    done
    (( ready == 1 )) || { printf 'topic readiness failed\n' >> "$RUN_LOG/session.txt"; exit 1; }
    abort_if_stop_requested
    printf '[topic types]\n%s\n%s\n' "$lt" "$it" > "$RUN_LOG/topic_types.txt"
    timeout 12 ros2 topic echo "$LIDAR_TOPIC" --once --no-arr >/dev/null 2>&1 || fail 'no live LiDAR message'
    timeout 12 ros2 topic echo "$IMU_TOPIC" --once >/dev/null 2>&1 || fail 'no live IMU message'
    abort_if_stop_requested
    write_state rate_check
    lidar_rate=$(timeout 9 ros2 topic hz "$LIDAR_TOPIC" 2>&1 | awk '/average rate:/{print $3; exit}' || true)
    imu_rate=$(timeout 9 ros2 topic hz "$IMU_TOPIC" 2>&1 | awk '/average rate:/{print $3; exit}' || true)
    awk -v x="${lidar_rate:-0}" 'BEGIN {exit !(x >= 8 && x <= 12)}' || fail "LiDAR rate out of range: ${lidar_rate:-unknown}"
    awk -v x="${imu_rate:-0}" 'BEGIN {exit !(x >= 160 && x <= 240)}' || fail "IMU rate out of range: ${imu_rate:-unknown}"
    abort_if_stop_requested
    write_state recorder_start
    setsid ros2 bag record --storage sqlite3 --max-cache-size 33554432 -o "$OUTPUT" "$LIDAR_TOPIC" "$IMU_TOPIC" >"$RUN_LOG/recorder.log" 2>&1 &
    REC_PID=$!
    recorder_ready=0
    for _ in $(seq 1 12); do
      if grep -q 'Recording' "$RUN_LOG/recorder.log" 2>/dev/null; then recorder_ready=1; break; fi
      kill -0 "$REC_PID" 2>/dev/null || break
      sleep 1
    done
    if (( recorder_ready == 0 )); then
      printf 'recorder did not become ready\n' >> "$RUN_LOG/session.txt"
      kill -INT -- "-$REC_PID" 2>/dev/null || kill -INT "$REC_PID" 2>/dev/null || true
      wait "$REC_PID" 2>/dev/null || true
      mkdir -p "$OUTPUT"
      touch "$OUTPUT/FAILED"
      cp -f "$RUN_LOG"/* "$OUTPUT/" 2>/dev/null || true
      rm -f "$STATE_FILE"
      exit 1
    fi
    setsid python3 "$WATCHDOG" --heartbeat "$RUN_LOG/watchdog.tsv" --interface eth0 >"$RUN_LOG/watchdog.log" 2>&1 &
    WD_PID=$!
    START_MONO=$(monotonic_seconds); STOP_MONO=0; DEADLINE=$((START_MONO + MINUTES * 60)); PROMPT_DEADLINE=0; write_state recording
    printf 'timestamp\tcpu_temp_millic\tthrottled\tloadavg\n' > "$RUN_LOG/health.tsv"
    KERNEL_LOG=/var/log/kern.log; KERNEL_LOG_LINES=0
    [[ -r "$KERNEL_LOG" ]] && KERNEL_LOG_LINES=$(wc -l < "$KERNEL_LOG")
    stop_reason=operator; abnormal=0; expected_stop=0; last_size=0; stagnant=0; prompt_count=0; STOP_NOW=0; last_rx_dropped=-1; last_rx_errors=-1
    trap 'stop_reason=signal; abnormal=1; STOP_NOW=1' INT TERM HUP
    while kill -0 "$REC_PID" 2>/dev/null && (( STOP_NOW == 0 )); do
      now=$(monotonic_seconds)
      [[ -e "$CONTROL_ROOT/stop" ]] && { rm -f "$CONTROL_ROOT/stop"; stop_reason=operator; expected_stop=1; break; }
      if [[ -e "$CONTROL_ROOT/extend" ]]; then rm -f "$CONTROL_ROOT/extend"; DEADLINE=$((now + 3600)); PROMPT_DEADLINE=0; write_state recording; fi
      runtime_storage_guard >/dev/null 2>>"$RUN_LOG/storage.log" || { stop_reason=storage_failure; abnormal=1; break; }
      check_health || { stop_reason=thermal_or_power; abnormal=1; break; }
      check_kernel_errors || { stop_reason=kernel_io_error; abnormal=1; break; }
      latest=$(find "$OUTPUT" -maxdepth 1 -name '*.db3' -printf '%s\n' 2>/dev/null | awk '{s+=$1} END{print s+0}')
      if (( latest <= last_size )); then stagnant=$((stagnant + 1)); else stagnant=0; last_size=$latest; fi
      (( stagnant < 3 )) || { stop_reason=write_stall; abnormal=1; break; }
      hb=$(tail -n 1 "$RUN_LOG/watchdog.tsv" 2>/dev/null || true)
      heartbeat_epoch_ms=$(awk '{print $1}' <<< "$hb")
      lidar_age=$(awk '{print $2}' <<< "$hb")
      imu_age=$(awk '{print $3}' <<< "$hb")
      carrier=$(awk '{print $4}' <<< "$hb")
      rx_dropped=$(awk '{print $7}' <<< "$hb")
      rx_errors=$(awk '{print $8}' <<< "$hb")
      kill -0 "$WD_PID" 2>/dev/null || { stop_reason=watchdog_exited; abnormal=1; break; }
      if [[ "$heartbeat_epoch_ms" =~ ^[0-9]+$ ]]; then
        now_epoch_ms=$(date +%s%3N)
        (( now_epoch_ms - heartbeat_epoch_ms <= 3000 )) || { stop_reason=watchdog_stall; abnormal=1; break; }
      fi
      [[ "$carrier" != 0 ]] || { stop_reason=carrier_down; abnormal=1; break; }
      [[ ! "$lidar_age" =~ ^[0-9]+$ || "$lidar_age" -le 3000 ]] || { stop_reason=lidar_stall; abnormal=1; break; }
      [[ ! "$imu_age" =~ ^[0-9]+$ || "$imu_age" -le 3000 ]] || { stop_reason=imu_stall; abnormal=1; break; }
      if [[ "$rx_dropped" =~ ^[0-9]+$ && "$rx_errors" =~ ^[0-9]+$ ]]; then
        (( last_rx_dropped < 0 || (rx_dropped == last_rx_dropped && rx_errors == last_rx_errors) )) || { stop_reason=eth0_rx_error; abnormal=1; break; }
        last_rx_dropped=$rx_dropped; last_rx_errors=$rx_errors
      fi
      if (( now >= DEADLINE )); then
        prompt_count=$((prompt_count + 1))
        PROMPT_DEADLINE=$((now + 30)); write_state prompt
        while (( $(monotonic_seconds) < PROMPT_DEADLINE )); do
          [[ -e "$CONTROL_ROOT/extend" ]] && { rm -f "$CONTROL_ROOT/extend"; DEADLINE=$(( $(monotonic_seconds) + 3600 )); PROMPT_DEADLINE=0; write_state recording; break; }
          [[ -e "$CONTROL_ROOT/stop" ]] && { rm -f "$CONTROL_ROOT/stop"; stop_reason=operator; expected_stop=1; break 2; }
          sleep 1
        done
        (( $(monotonic_seconds) < DEADLINE )) || { stop_reason=timeout; expected_stop=1; break; }
      fi
      sleep 10
    done
    STOP_MONO=$(monotonic_seconds); PROMPT_DEADLINE=0; write_state stopping
    if [[ -n "${WD_PID:-}" ]]; then
      kill -TERM "$WD_PID" 2>/dev/null || true
      wait "$WD_PID" 2>/dev/null || true
    fi
    if ! kill -0 "$REC_PID" 2>/dev/null && (( abnormal == 0 && expected_stop == 0 )); then
      stop_reason=recorder_exited; abnormal=1
    fi
    if kill -0 "$REC_PID" 2>/dev/null; then kill -INT -- "-$REC_PID" 2>/dev/null || kill -INT "$REC_PID" 2>/dev/null || true; fi
    for _ in $(seq 1 30); do kill -0 "$REC_PID" 2>/dev/null || break; sleep 1; done
    kill -TERM -- "-$REC_PID" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$REC_PID" 2>/dev/null || break; sleep 1; done
    kill -KILL -- "-$REC_PID" 2>/dev/null || true
    wait "$REC_PID" 2>/dev/null || true
    printf 'stop_reason=%s\nfinished=%s\nrecorded_seconds=%s\n' \
      "$stop_reason" "$(date -Is)" "$((STOP_MONO - START_MONO))" >> "$RUN_LOG/session.txt"
    (( abnormal == 0 )) || capture_evidence
    write_state verifying
    if [[ -f "$OUTPUT/metadata.yaml" ]] && compgen -G "$OUTPUT/*.db3" >/dev/null; then
      source_ros
      verify_completed_bag || abnormal=1
      (cd "$OUTPUT" && sha256sum -- *.db3 metadata.yaml) > "$OUTPUT/bag_files.sha256" || abnormal=1
      cp -f "$RUN_LOG"/* "$OUTPUT/" 2>/dev/null || true
      sync
      (( abnormal == 0 )) && touch "$OUTPUT/COMPLETE"
    else
      abnormal=1; touch "$OUTPUT/FAILED"
    fi
    (( abnormal == 0 )) || touch "$OUTPUT/FAILED"
    rm -f "$STATE_FILE"
    (( abnormal == 0 )) || exit 1
    ;;
  stop)
    ensure_dirs
    [[ -r "$STATE_FILE" ]] || fail 'no active recording'
    touch "$CONTROL_ROOT/stop"
    printf 'safe stop requested\n' ;;
  extend)
    ensure_dirs
    [[ -r "$STATE_FILE" ]] || fail 'no active recording'
    touch "$CONTROL_ROOT/extend"; printf 'requested another 60 minutes\n' ;;
  watch)
    ensure_dirs
    valid_label "$LABEL" || fail 'invalid label'
    if systemctl --user is-active --quiet "carrot-bag@${LABEL}.service"; then
      monitor_recording "$LABEL"
    else
      output=$(latest_output_for_label "$LABEL")
      [[ -n "$output" ]] || fail "no active or completed recording named $LABEL"
      print_run_summary "$output" '服务已结束'
    fi ;;
  status)
    [[ -r "$STATE_FILE" ]] && cat "$STATE_FILE" || echo 'no active recording' ;;
  logs)
    valid_label "$LABEL" || fail 'invalid label'
    if systemctl --user is-active --quiet "carrot-bag@${LABEL}.service"; then
      journalctl --user -u "carrot-bag@${LABEL}.service" -n 50 -f
    else
      journalctl --user -u "carrot-bag@${LABEL}.service" -n 100 --no-pager
    fi ;;
  driver-stop)
    if [[ -r "$STATE_FILE" ]]; then
      active_label=$(state_get label)
      touch "$CONTROL_ROOT/stop"
      for _ in $(seq 1 90); do
        systemctl --user is-active --quiet "carrot-bag@${active_label}.service" || break
        sleep 2
      done
      systemctl --user is-active --quiet "carrot-bag@${active_label}.service" && fail 'recorder did not stop safely; driver left running'
    fi
    systemctl --user stop "$DRIVER_UNIT" ;;
  *) usage; exit 2 ;;
esac
